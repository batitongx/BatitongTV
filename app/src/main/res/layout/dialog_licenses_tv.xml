<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@color/tv_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/license_dialog_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/tv_text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLicenseNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Aplikasi ini dikembangkan dari basis proyek open source di bawah lisensi Apache License 2.0 (Copyright oleh Hari Murti)."
        android:textColor="@color/tv_text_secondary"
        android:textSize="@dimen/tv_text_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="4dp"
        android:text="Aplikasi ini mendistribusikan perangkat lunak bebas di bawah syarat lisensi Apache 2.0. Layanan berbayar yang mungkin tersedia hanya mencakup akses playlist/gateway pihak ketiga, bukan penjualan biner APK aplikasi ini."
        android:textColor="@color/tv_text_tertiary"
        android:textSize="@dimen/tv_text_caption" />

    <Button
        android:id="@+id/btnLicenseClose"
        style="@style/Widget.BatitongTV.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:text="@string/btn_close" />

</LinearLayout>
