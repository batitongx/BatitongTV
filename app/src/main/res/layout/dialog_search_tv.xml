<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600dp"
    android:layout_height="480dp"
    android:background="@color/tv_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/nav_search"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/tv_text_title"
        android:textStyle="bold" />

    <!-- Input Pencarian TV Friendly -->
    <EditText
        android:id="@+id/etSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/selector_item_tv"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_tertiary"
        android:textSize="@dimen/tv_text_body" />

    <!-- Hasil Pencarian -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true" />

    <TextView
        android:id="@+id/tvSearchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/search_empty"
        android:textColor="@color/tv_text_secondary"
        android:textSize="@dimen/tv_text_body"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSearchClose"
        style="@style/Widget.BatitongTV.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="@string/btn_close" />

</LinearLayout>
