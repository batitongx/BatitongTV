<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="400dp"
    android:background="@color/tv_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/player_audio_selector"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/tv_text_title"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAudioTracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true" />

    <Button
        android:id="@+id/btnTrackClose"
        style="@style/Widget.BatitongTV.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="@string/btn_close" />

</LinearLayout>
